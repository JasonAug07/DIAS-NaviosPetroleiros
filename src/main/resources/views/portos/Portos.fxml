<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.petroleiros.controller.PortosController"
      spacing="12" styleClass="modulo-container">
    <padding><Insets top="20" left="20" right="20" bottom="20"/></padding>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Gestão de Portos" styleClass="titulo-modulo"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button text="+ Registar Porto" onAction="#abrirFormularioNovo" styleClass="btn-primary"/>
    </HBox>
    <Separator/>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="filtroBusca" promptText="Pesquisar por nome ou país..." prefWidth="300"/>
        <Button text="Pesquisar" onAction="#pesquisar"/>
    </HBox>
    <TableView fx:id="tabelaPortos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNome" text="Nome" prefWidth="250"/>
            <TableColumn fx:id="colPais" text="País" prefWidth="200"/>
        </columns>
        <placeholder><Label text="Nenhum porto registado."/></placeholder>
    </TableView>
    <HBox spacing="10">
        <Button text="✏️  Editar"   onAction="#editarSelecionado"/>
        <Button text="🗑️  Eliminar" onAction="#eliminarSelecionado" styleClass="btn-danger"/>
    </HBox>
</VBox>
