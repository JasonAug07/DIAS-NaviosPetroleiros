<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.petroleiros.controller.ViagemTripulacaoController"
      spacing="12" styleClass="modulo-container" stylesheets="@../estilos.css">
    <padding><Insets top="16" left="16" right="16" bottom="16"/></padding>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label fx:id="labelTitulo" text="Tripulação da Viagem" styleClass="titulo-modulo"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button text="+ Associar Tripulante" onAction="#associarTripulante" styleClass="btn-primary"/>
    </HBox>
    <Separator/>
    <TableView fx:id="tabelaTripulacao" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNome"   text="Nome"   prefWidth="220"/>
            <TableColumn fx:id="colFuncao" text="Função" prefWidth="140"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="140"/>
        </columns>
        <placeholder><Label text="Sem tripulação associada a esta viagem."/></placeholder>
    </TableView>
    <HBox spacing="10">
        <Button text="Remover Tripulante" onAction="#removerTripulante" styleClass="btn-danger"/>
    </HBox>
</VBox>
